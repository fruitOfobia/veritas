<% content_for :title, "#{@category.name} — BuildBazaar" %>

<div class="container-page py-10">
  <nav class="text-sm text-ink-400 mb-4">
    <%= link_to "Home", root_path, class: "hover:text-brand-600" %> / <span class="text-ink-700"><%= @category.name %></span>
  </nav>
  <h1 class="text-3xl mb-8"><%= @category.name %></h1>

  <div class="flex flex-col lg:flex-row gap-8">
    <%= render "shared/filter_sidebar", subcategories: @subcategories %>

    <div class="flex-1">
      <%= render "shared/sort_bar", count: @pagy.count %>

      <% if @products.any? %>
        <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 gap-5">
          <% @products.each do |product| %>
            <%= render "shared/product_card", product: product %>
          <% end %>
        </div>
        <%= render "shared/pagination", pagy: @pagy %>
      <% else %>
        <%= render "shared/empty_state", title: "No products yet", message: "Check back soon — we're stocking this category." %>
      <% end %>
    </div>
  </div>
</div>
