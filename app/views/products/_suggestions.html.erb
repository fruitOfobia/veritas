<% if query.length < 2 %>
  <p class="px-4 py-6 text-sm text-ink-400 text-center">Keep typing to search products…</p>
<% elsif products.none? && categories.none? %>
  <p class="px-4 py-6 text-sm text-ink-400 text-center">No matches for “<%= query %>”.</p>
<% else %>
  <% if categories.any? %>
    <p class="px-4 pt-3 pb-1 text-xs font-semibold text-ink-400 uppercase tracking-wide">Categories</p>
    <ul>
      <% categories.each do |category| %>
        <li>
          <%= link_to category_path(category), data: { "search-target": "item" }, class: "flex items-center gap-3 px-4 py-2 hover:bg-ink-50" do %>
            <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-ink-100 text-ink-500 shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7" /></svg>
            </span>
            <span class="text-sm font-medium text-ink-800"><%= category.name %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <% if products.any? %>
    <p class="px-4 pt-3 pb-1 text-xs font-semibold text-ink-400 uppercase tracking-wide">Products</p>
    <ul>
      <% products.each do |product| %>
        <li>
          <%= link_to product_path(product), data: { "search-target": "item" }, class: "flex items-center gap-3 px-4 py-2 hover:bg-ink-50" do %>
            <span class="h-10 w-10 rounded-lg bg-ink-50 overflow-hidden shrink-0">
              <% if product.images.attached? %>
                <%= image_tag product.images.first, class: "h-full w-full object-cover" %>
              <% end %>
            </span>
            <span class="min-w-0 flex-1">
              <span class="block text-sm font-medium text-ink-800 truncate"><%= product.name %></span>
              <span class="block text-xs text-ink-400"><%= product.category.name %></span>
            </span>
            <span class="text-sm font-semibold text-ink-900 shrink-0"><%= currency(product.price) %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <%= link_to search_path(q: query), data: { "search-target": "item" }, class: "block px-4 py-2.5 text-sm font-semibold text-brand-600 hover:bg-brand-50 border-t border-ink-100" do %>
    See all results for “<%= query %>”
  <% end %>
<% end %>
