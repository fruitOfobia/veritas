<% content_for :title, "#{@product.name} — BuildBazaar" %>

<div class="container-page py-10">
  <nav class="text-sm text-ink-400 mb-6">
    <%= link_to "Home", root_path, class: "hover:text-brand-600" %> /
    <%= link_to @product.category.name, category_path(@product.category), class: "hover:text-brand-600" %> /
    <span class="text-ink-700"><%= @product.name %></span>
  </nav>

  <div class="grid lg:grid-cols-2 gap-10">
    <div data-controller="gallery">
      <div class="card aspect-square overflow-hidden mb-4">
        <% if @product.images.attached? %>
          <%= image_tag @product.images.first, data: { gallery_target: "main" }, class: "h-full w-full object-cover" %>
        <% else %>
          <div class="h-full w-full flex items-center justify-center text-ink-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-20 w-20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5V6a1.5 1.5 0 011.5-1.5h15A1.5 1.5 0 0121 6v10.5M3 16.5l5-5 3.5 3.5L16 10l5 5M3 16.5V18a1.5 1.5 0 001.5 1.5h15A1.5 1.5 0 0021 18v-1.5" /></svg>
          </div>
        <% end %>
      </div>
      <% if @product.images.attached? && @product.images.count > 1 %>
        <div class="flex gap-3">
          <% @product.images.each do |image| %>
            <button data-action="click->gallery#select" data-full-url="<%= url_for(image) %>" data-gallery-target="thumb" class="h-16 w-16 rounded-lg overflow-hidden border border-ink-100">
              <%= image_tag image, class: "h-full w-full object-cover" %>
            </button>
          <% end %>
        </div>
      <% end %>
    </div>

    <div>
      <p class="text-xs font-semibold text-brand-600 uppercase tracking-wide"><%= @product.category.name %></p>
      <h1 class="text-2xl sm:text-3xl mt-1"><%= @product.name %></h1>

      <div class="flex items-center gap-2 mt-2">
        <span class="text-brand-500 text-sm"><%= star_rating(@product.average_rating) %></span>
        <span class="text-sm text-ink-400">(<%= @product.product_reviews.size %> review<%= "s" unless @product.product_reviews.size == 1 %>)</span>
        <span class="text-ink-200">•</span>
        <span class="text-xs font-mono text-ink-400">SKU <%= @product.sku %></span>
      </div>

      <div class="mt-5 flex items-baseline gap-3">
        <span class="text-3xl font-display font-bold text-ink-900"><%= currency(@product.price) %></span>
        <% if @product.on_sale? %>
          <span class="text-lg text-ink-300 line-through"><%= currency(@product.mrp) %></span>
          <span class="badge-brand"><%= @product.discount_percent %>% off</span>
        <% end %>
        <span class="text-sm text-ink-400">/ <%= @product.unit %></span>
      </div>

      <p class="mt-2 text-sm <%= @product.in_stock? ? 'text-teal-600' : 'text-red-500' %> font-medium">
        <%= @product.in_stock? ? "In stock (#{@product.stock} available)" : "Out of stock" %>
      </p>

      <p class="mt-5 text-ink-600 leading-relaxed"><%= simple_format(@product.description) %></p>

      <% if user_signed_in? %>
        <div class="mt-7 flex items-center gap-3">
          <%= form_with url: add_item_cart_path, method: :post, data: { controller: "quantity" }, class: "flex items-center gap-3" do %>
            <%= hidden_field_tag :product_id, @product.id %>
            <div class="flex items-center border border-ink-200 rounded-lg">
              <button type="button" data-action="quantity#decrement" class="px-3 py-2.5 text-ink-500 hover:text-brand-500">−</button>
              <input type="number" name="quantity" value="1" min="1" data-quantity-target="input" class="w-12 text-center border-x border-ink-200 py-2.5 focus:outline-none">
              <button type="button" data-action="quantity#increment" class="px-3 py-2.5 text-ink-500 hover:text-brand-500">+</button>
            </div>
            <button type="submit" class="btn-primary px-6" <%= "disabled" unless @product.in_stock? %>>Add to Cart</button>
          <% end %>

          <%= button_to toggle_wishlist_path(product_id: @product.id), method: :post, class: "h-11 w-11 flex items-center justify-center rounded-lg border border-ink-200 text-ink-500 hover:text-brand-500" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="<%= wishlist_product_ids.include?(@product.id) ? 'currentColor' : 'none' %>" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 016.364 0L12 7.636l1.318-1.318a4.5 4.5 0 116.364 6.364L12 21l-7.682-7.682a4.5 4.5 0 010-6.364z" /></svg>
          <% end %>
        </div>
      <% else %>
        <div class="mt-7">
          <%= link_to "Sign in to buy", new_user_session_path, class: "btn-primary px-6" %>
        </div>
      <% end %>

      <%= link_to new_quote_path(product_id: @product.id), class: "mt-3 inline-flex btn-outline w-full sm:w-auto" do %>
        Request Bulk Quote for This Product
      <% end %>

      <% if @product.specifications.present? && @product.specifications.any? %>
        <div class="mt-8 card p-5">
          <h3 class="font-semibold text-ink-900 mb-3">Specifications</h3>
          <dl class="divide-y divide-ink-100 text-sm">
            <% @product.specifications.each do |key, value| %>
              <div class="flex justify-between py-2">
                <dt class="text-ink-400"><%= key.to_s.titleize %></dt>
                <dd class="text-ink-800 font-medium"><%= value %></dd>
              </div>
            <% end %>
          </dl>
        </div>
      <% end %>
    </div>
  </div>

  <section class="mt-16">
    <h2 class="text-2xl mb-6">Customer Reviews</h2>

    <% if user_signed_in? %>
      <%= form_with model: [@product, @review], url: product_product_reviews_path(@product), class: "card p-5 mb-8 max-w-xl" do |f| %>
        <div class="mb-3">
          <label class="label">Rating</label>
          <%= f.select :rating, (1..5).to_a.reverse, {}, class: "input !w-32" %>
        </div>
        <div class="mb-3">
          <label class="label">Comment</label>
          <%= f.text_area :comment, rows: 3, class: "input" %>
        </div>
        <%= f.submit "Submit Review", class: "btn-primary" %>
      <% end %>
    <% end %>

    <% if @product.product_reviews.any? %>
      <div class="space-y-4 max-w-2xl">
        <% @product.product_reviews.each do |review| %>
          <div class="card p-4">
            <div class="flex items-center justify-between">
              <p class="font-semibold text-ink-800"><%= review.user.name %></p>
              <span class="text-brand-500 text-sm"><%= star_rating(review.rating) %></span>
            </div>
            <p class="text-sm text-ink-600 mt-1"><%= review.comment %></p>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-ink-400">No reviews yet — be the first to review this product.</p>
    <% end %>
  </section>

  <% if @related_products.any? %>
    <section class="mt-16">
      <h2 class="text-2xl mb-6">You May Also Like</h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-5">
        <% @related_products.each do |product| %>
          <%= render "shared/product_card", product: product %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
