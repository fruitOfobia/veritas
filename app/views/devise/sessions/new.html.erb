<% content_for :title, "Sign In — BuildBazaar" %>

<div class="container-page py-16 max-w-md mx-auto">
  <h1 class="text-2xl text-center mb-1">Welcome back</h1>
  <p class="text-sm text-ink-400 text-center mb-6">Sign in to manage orders, quotes and your wishlist.</p>

  <div class="card p-6">
    <%= form_for(resource, as: resource_name, url: session_path(resource_name), class: "space-y-4") do |f| %>
      <div>
        <label class="label">Email</label>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input" %>
      </div>

      <div>
        <label class="label">Password</label>
        <%= f.password_field :password, autocomplete: "current-password", class: "input" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <label class="flex items-center gap-2 text-sm text-ink-600">
          <%= f.check_box :remember_me, class: "rounded border-ink-300" %> Remember me
        </label>
      <% end %>

      <%= f.submit "Sign In", class: "btn-primary w-full" %>
    <% end %>
  </div>

  <%= render "devise/shared/links" %>
</div>
