<div class="mt-5 text-sm text-center text-ink-500 space-y-1.5">
  <% if controller_name != "sessions" %>
    <p><%= link_to "Sign in", new_session_path(resource_name), class: "text-brand-600 font-semibold" %></p>
  <% end %>

  <% if devise_mapping.registerable? && controller_name != "registrations" %>
    <p><%= link_to "Create an account", new_registration_path(resource_name), class: "text-brand-600 font-semibold" %></p>
  <% end %>

  <% if devise_mapping.recoverable? && controller_name != "passwords" && controller_name != "registrations" %>
    <p><%= link_to "Forgot your password?", new_password_path(resource_name), class: "text-brand-600 font-semibold" %></p>
  <% end %>
</div>
