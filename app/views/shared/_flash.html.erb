<% if notice %>
  <div class="container-page pt-4">
    <div class="rounded-xl bg-teal-50 border border-teal-100 text-teal-700 px-4 py-3 text-sm font-medium">
      <%= notice %>
    </div>
  </div>
<% end %>
<% if alert %>
  <div class="container-page pt-4">
    <div class="rounded-xl bg-red-50 border border-red-100 text-red-700 px-4 py-3 text-sm font-medium">
      <%= alert %>
    </div>
  </div>
<% end %>
