<header class="sticky top-0 z-40 bg-white border-b border-ink-100">
  <div class="bg-ink-900 text-ink-200 text-xs">
    <div class="container-page flex h-9 items-center justify-between">
      <p class="hidden sm:block">Bulk pricing for contractors & designers — <%= link_to "request a quote", new_quote_path, class: "text-brand-300 font-semibold hover:text-brand-200" %></p>
      <p class="sm:hidden font-medium">Welcome to Veritas</p>
      <div class="flex items-center gap-4">
        <%= link_to "Track Order", orders_path, class: "hover:text-white" %>
        <%= link_to "Help", "#", class: "hidden sm:inline hover:text-white" %>
      </div>
    </div>
  </div>

  <div class="container-page flex items-center gap-4 py-4">
    <button data-action="click->mobile-menu#toggle" class="lg:hidden text-ink-600" aria-label="Open menu">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" /></svg>
    </button>

    <%= link_to root_path, class: "flex items-center gap-2 shrink-0" do %>
      <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-500 text-white font-display font-bold">V</span>
      <span class="font-display text-xl font-bold text-ink-900">Veri<span class="text-brand-500">tas</span></span>
    <% end %>

    <div class="hidden md:block flex-1 max-w-xl" data-controller="search" data-search-url-value="<%= search_suggestions_path %>">
      <%= form_with url: search_path, method: :get, class: "relative w-full" do %>
        <div class="relative w-full">
          <input type="search" name="q" value="<%= params[:q] %>" placeholder="Search for tiles, faucets, plywood, lights…"
                 class="input pr-10" autocomplete="off" data-search-target="input"
                 data-action="input->search#search focus->search#onFocus keydown->search#onKeydown">
          <button type="submit" class="absolute inset-y-0 right-0 flex items-center px-3 text-ink-400 hover:text-brand-500" aria-label="Search">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 104.5 4.5a7.5 7.5 0 0012.15 12.15z" /></svg>
          </button>
        </div>
        <div data-search-target="results" class="hidden absolute left-0 right-0 mt-2 max-h-96 overflow-y-auto rounded-xl border border-ink-100 bg-white shadow-lg z-50"></div>
      <% end %>
    </div>

    <nav class="ml-auto flex items-center gap-1 sm:gap-2">
      <%= link_to new_quote_path, class: "hidden sm:inline-flex btn-outline" do %>
        Request a Quote
      <% end %>

      <%= link_to wishlist_path, class: "relative p-2 text-ink-600 hover:text-brand-500", aria: { label: "Wishlist" } do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 016.364 0L12 7.636l1.318-1.318a4.5 4.5 0 116.364 6.364L12 21l-7.682-7.682a4.5 4.5 0 010-6.364z" /></svg>
        <% if user_signed_in? && current_wishlist&.wishlist_items&.any? %>
          <span class="absolute -top-1 -right-1 flex h-5 w-5 items-center justify-center rounded-full bg-brand-500 text-[10px] font-bold text-white"><%= current_wishlist.wishlist_items.count %></span>
        <% end %>
      <% end %>

      <%= link_to cart_path, class: "relative p-2 text-ink-600 hover:text-brand-500", aria: { label: "Cart" } do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l3.6-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m-9-4h9m-9 4a1 1 0 102 0 1 1 0 00-2 0zm9 0a1 1 0 102 0 1 1 0 00-2 0z" /></svg>
        <% if cart_item_count > 0 %>
          <span class="absolute -top-1 -right-1 flex h-5 w-5 items-center justify-center rounded-full bg-brand-500 text-[10px] font-bold text-white"><%= cart_item_count %></span>
        <% end %>
      <% end %>

      <div class="relative" data-controller="dropdown">
        <button data-action="click->dropdown#toggle" class="flex items-center gap-1.5 p-2 text-ink-600 hover:text-brand-500">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
        </button>
        <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-56 rounded-xl border border-ink-100 bg-white p-2 shadow-lg z-50">
          <% if user_signed_in? %>
            <div class="px-3 py-2 border-b border-ink-100 mb-1">
              <p class="text-sm font-semibold text-ink-900"><%= current_user.name %></p>
              <p class="text-xs text-ink-400"><%= current_user.email %></p>
            </div>
            <%= link_to "My Profile", profile_path, class: "block rounded-lg px-3 py-2 text-sm text-ink-600 hover:bg-ink-50" %>
            <%= link_to "My Orders", orders_path, class: "block rounded-lg px-3 py-2 text-sm text-ink-600 hover:bg-ink-50" %>
            <%= link_to "My Quotes", quotes_path, class: "block rounded-lg px-3 py-2 text-sm text-ink-600 hover:bg-ink-50" %>
            <%= link_to "Addresses", addresses_path, class: "block rounded-lg px-3 py-2 text-sm text-ink-600 hover:bg-ink-50" %>
            <% if current_user.admin? %>
              <%= link_to "Admin Dashboard", admin_root_path, class: "block rounded-lg px-3 py-2 text-sm text-brand-600 font-medium hover:bg-brand-50" %>
            <% end %>
            <div class="border-t border-ink-100 mt-1 pt-1">
              <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "w-full text-left rounded-lg px-3 py-2 text-sm text-ink-600 hover:bg-ink-50" %>
            </div>
          <% else %>
            <%= link_to "Sign in", new_user_session_path, class: "block rounded-lg px-3 py-2 text-sm font-medium text-ink-700 hover:bg-ink-50" %>
            <%= link_to "Create account", new_user_registration_path, class: "block rounded-lg px-3 py-2 text-sm text-ink-600 hover:bg-ink-50" %>
          <% end %>
        </div>
      </div>
    </nav>
  </div>

  <nav class="hidden lg:block border-t border-ink-100">
    <div class="container-page flex items-center gap-6 h-12 text-sm font-medium text-ink-600">
      <% nav_categories.each do |category| %>
        <div class="group relative h-full flex items-center">
          <%= link_to category.name, category_path(category), class: "hover:text-brand-600" %>
          <% if category.subcategories.any? %>
            <div class="invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-opacity absolute left-0 top-full z-50 w-64 rounded-xl border border-ink-100 bg-white p-2 shadow-lg">
              <% category.subcategories.active.ordered.each do |sub| %>
                <%= link_to sub.name, category_path(sub), class: "block rounded-lg px-3 py-2 text-sm text-ink-600 hover:bg-brand-50 hover:text-brand-700" %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </nav>

  <div data-controller="mobile-menu" data-mobile-menu-target="panel" class="hidden lg:hidden border-t border-ink-100 bg-white px-4 py-3 space-y-1">
    <div class="mb-3" data-controller="search" data-search-url-value="<%= search_suggestions_path %>">
      <%= form_with url: search_path, method: :get, class: "relative" do %>
        <input type="search" name="q" value="<%= params[:q] %>" placeholder="Search products…" class="input" autocomplete="off"
               data-search-target="input" data-action="input->search#search focus->search#onFocus keydown->search#onKeydown">
        <div data-search-target="results" class="hidden absolute left-0 right-0 mt-2 max-h-80 overflow-y-auto rounded-xl border border-ink-100 bg-white shadow-lg z-50"></div>
      <% end %>
    </div>
    <% nav_categories.each do |category| %>
      <%= link_to category.name, category_path(category), class: "block rounded-lg px-3 py-2 text-sm font-medium text-ink-700 hover:bg-ink-50" %>
    <% end %>
    <%= link_to "Request a Quote", new_quote_path, class: "block rounded-lg px-3 py-2 text-sm font-semibold text-brand-600 hover:bg-brand-50" %>
  </div>
</header>
