<div class="card p-14 text-center">
  <div class="mx-auto h-14 w-14 rounded-full bg-ink-50 text-ink-300 flex items-center justify-center mb-4">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
  </div>
  <h3 class="text-lg font-semibold text-ink-800"><%= title %></h3>
  <p class="text-sm text-ink-400 mt-1"><%= message %></p>
  <% if local_assigns[:cta_text].present? %>
    <%= link_to cta_text, cta_path, class: "btn-primary inline-flex mt-5" %>
  <% end %>
</div>
