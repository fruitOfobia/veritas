<div class="card group relative overflow-hidden flex flex-col">
  <%= link_to product_path(product), class: "relative block aspect-square bg-ink-50 overflow-hidden" do %>
    <% if product.images.attached? %>
      <%= image_tag product.images.first, class: "h-full w-full object-cover group-hover:scale-105 transition-transform duration-300" %>
    <% else %>
      <div class="h-full w-full flex items-center justify-center text-ink-300">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-14 w-14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5V6a1.5 1.5 0 011.5-1.5h15A1.5 1.5 0 0121 6v10.5M3 16.5l5-5 3.5 3.5L16 10l5 5M3 16.5V18a1.5 1.5 0 001.5 1.5h15A1.5 1.5 0 0021 18v-1.5" /></svg>
      </div>
    <% end %>
    <% if product.on_sale? %>
      <span class="absolute top-2 left-2 badge-brand">-<%= product.discount_percent %>%</span>
    <% end %>
  <% end %>

  <% if user_signed_in? %>
    <%= button_to toggle_wishlist_path(product_id: product.id), method: :post, class: "absolute top-2 right-2 h-8 w-8 flex items-center justify-center rounded-full bg-white/90 text-ink-500 hover:text-brand-500 shadow-sm", form_class: "!absolute top-2 right-2" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="<%= wishlist_product_ids.include?(product.id) ? 'currentColor' : 'none' %>" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 016.364 0L12 7.636l1.318-1.318a4.5 4.5 0 116.364 6.364L12 21l-7.682-7.682a4.5 4.5 0 010-6.364z" /></svg>
    <% end %>
  <% end %>

  <div class="p-4 flex flex-col gap-1.5 flex-1">
    <p class="text-xs font-medium text-ink-400 uppercase tracking-wide"><%= product.category.name %></p>
    <%= link_to product.name, product_path(product), class: "font-semibold text-ink-900 leading-snug line-clamp-2 hover:text-brand-600" %>

    <div class="mt-1 flex items-baseline gap-2">
      <span class="font-display font-bold text-ink-900"><%= currency(product.price) %></span>
      <% if product.on_sale? %>
        <span class="text-sm text-ink-300 line-through"><%= currency(product.mrp) %></span>
      <% end %>
      <span class="text-xs text-ink-400">/ <%= product.unit %></span>
    </div>

    <div class="mt-auto pt-3 flex gap-2">
      <% if user_signed_in? %>
        <%= button_to "Add to Cart", add_item_cart_path(product_id: product.id), method: :post, class: "btn-secondary flex-1 !py-2 text-xs sm:text-sm", disabled: !product.in_stock? %>
      <% else %>
        <%= link_to "Add to Cart", new_user_session_path, class: "btn-secondary flex-1 !py-2 text-xs sm:text-sm" %>
      <% end %>
    </div>
  </div>
</div>
