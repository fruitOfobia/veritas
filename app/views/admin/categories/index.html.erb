<% content_for :title, "Categories — Admin" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl">Categories</h1>
  <%= link_to "+ New Category", new_admin_category_path, class: "btn-primary" %>
</div>

<div class="card overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="bg-ink-50 text-ink-500 text-left">
      <tr>
        <th class="px-4 py-3 font-medium">Name</th>
        <th class="px-4 py-3 font-medium">Parent</th>
        <th class="px-4 py-3 font-medium">Products</th>
        <th class="px-4 py-3 font-medium">Active</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-ink-100">
      <% @categories.each do |category| %>
        <tr>
          <td class="px-4 py-3">
            <%= link_to category.name, admin_category_path(category), class: "font-medium text-ink-900 hover:text-brand-600" %>
          </td>
          <td class="px-4 py-3 text-ink-500"><%= category.parent&.name || "—" %></td>
          <td class="px-4 py-3 text-ink-500"><%= category.products.count %></td>
          <td class="px-4 py-3"><span class="badge-<%= category.is_active? ? 'teal' : 'ink' %>"><%= category.is_active? ? "Active" : "Inactive" %></span></td>
          <td class="px-4 py-3">
            <%= render "admin/row_actions",
                  label: category.name,
                  view_path: admin_category_path(category),
                  edit_path: edit_admin_category_path(category),
                  delete_path: admin_category_path(category),
                  confirm: "Delete #{category.name}? Its subcategories and products will be deleted too." %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
