<% content_for :title, "Categories — Admin" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl">Categories</h1>
  <%= link_to "+ New Category", new_admin_category_path, class: "btn-primary" %>
</div>

<div class="card overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="bg-ink-50 text-ink-500 text-left">
      <tr>
        <th class="px-4 py-3 font-medium">Name</th>
        <th class="px-4 py-3 font-medium">Parent</th>
        <th class="px-4 py-3 font-medium">Products</th>
        <th class="px-4 py-3 font-medium">Active</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-ink-100">
      <% @categories.each do |category| %>
        <tr>
          <td class="px-4 py-3 font-medium text-ink-900"><%= category.name %></td>
          <td class="px-4 py-3 text-ink-500"><%= category.parent&.name || "—" %></td>
          <td class="px-4 py-3 text-ink-500"><%= category.products.count %></td>
          <td class="px-4 py-3"><span class="badge-<%= category.is_active? ? 'teal' : 'ink' %>"><%= category.is_active? ? "Active" : "Inactive" %></span></td>
          <td class="px-4 py-3 text-right space-x-3">
            <%= link_to "Edit", edit_admin_category_path(category), class: "text-brand-600 font-medium" %>
            <%= button_to "Delete", admin_category_path(category), method: :delete, class: "text-red-500 font-medium bg-transparent p-0 inline", form: { data: { turbo_confirm: "Delete this category?" } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
