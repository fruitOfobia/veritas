<% content_for :title, "#{@category.name} — Admin" %>

<nav class="text-sm text-ink-400 mb-4">
  <%= link_to "Categories", admin_categories_path, class: "hover:text-brand-600" %> /
  <span class="text-ink-700"><%= @category.name %></span>
</nav>

<div class="flex items-start justify-between gap-4 mb-6">
  <div>
    <h1 class="text-2xl"><%= @category.name %></h1>
    <p class="text-sm text-ink-400 mt-1">
      <span class="font-mono"><%= @category.slug %></span>
      <% if @category.parent %>
        • under <%= link_to @category.parent.name, admin_category_path(@category.parent), class: "text-brand-600" %>
      <% else %>
        • top-level category
      <% end %>
    </p>
  </div>
  <div class="flex items-center gap-2 shrink-0">
    <%= link_to "View on storefront", category_path(@category), class: "btn-outline !py-1.5", target: "_blank", rel: "noopener" %>
    <%= link_to "Edit", edit_admin_category_path(@category), class: "btn-primary !py-1.5" %>
  </div>
</div>

<div class="grid sm:grid-cols-4 gap-4 mb-8">
  <div class="card p-5">
    <p class="text-xs font-medium text-ink-400 uppercase tracking-wide">Products</p>
    <p class="text-2xl font-display font-bold text-ink-900 mt-1"><%= @products.size %></p>
  </div>
  <div class="card p-5">
    <p class="text-xs font-medium text-ink-400 uppercase tracking-wide">Subcategories</p>
    <p class="text-2xl font-display font-bold text-ink-900 mt-1"><%= @subcategories.size %></p>
  </div>
  <div class="card p-5">
    <p class="text-xs font-medium text-ink-400 uppercase tracking-wide">Status</p>
    <p class="mt-2"><span class="badge-<%= @category.is_active? ? 'teal' : 'ink' %>"><%= @category.is_active? ? "Active" : "Inactive" %></span></p>
  </div>
  <div class="card p-5">
    <p class="text-xs font-medium text-ink-400 uppercase tracking-wide">Position</p>
    <p class="text-2xl font-display font-bold text-ink-900 mt-1"><%= @category.position %></p>
  </div>
</div>

<% if @category.description.present? %>
  <div class="card p-5 mb-8">
    <h3 class="text-sm font-semibold text-ink-900 mb-1">Description</h3>
    <p class="text-sm text-ink-600"><%= @category.description %></p>
  </div>
<% end %>

<% if @subcategories.any? %>
  <h2 class="text-lg font-semibold text-ink-900 mb-3">Subcategories</h2>
  <div class="card divide-y divide-ink-100 mb-8">
    <% @subcategories.each do |sub| %>
      <div class="flex items-center justify-between p-4">
        <%= link_to sub.name, admin_category_path(sub), class: "text-sm font-medium text-ink-800 hover:text-brand-600" %>
        <span class="text-sm text-ink-400"><%= sub.products.count %> products</span>
      </div>
    <% end %>
  </div>
<% end %>

<div class="flex items-center justify-between mb-3">
  <h2 class="text-lg font-semibold text-ink-900">Products in this category</h2>
  <%= link_to "+ New Product", new_admin_product_path, class: "text-sm font-semibold text-brand-600" %>
</div>

<% if @products.any? %>
  <div class="card overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="bg-ink-50 text-ink-500 text-left">
        <tr>
          <th class="px-4 py-3 font-medium">Product</th>
          <th class="px-4 py-3 font-medium">Price</th>
          <th class="px-4 py-3 font-medium">Stock</th>
          <th class="px-4 py-3 font-medium">Status</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-ink-100">
        <% @products.each do |product| %>
          <tr>
            <td class="px-4 py-3">
              <div class="flex items-center gap-3">
                <% if product.images.attached? %>
                  <%= image_tag product.images.first, class: "h-10 w-10 rounded-lg object-cover" %>
                <% else %>
                  <div class="h-10 w-10 rounded-lg bg-ink-100"></div>
                <% end %>
                <div>
                  <%= link_to product.name, admin_product_path(product), class: "font-medium text-ink-900 hover:text-brand-600" %>
                  <p class="text-xs text-ink-400"><%= product.sku %></p>
                </div>
              </div>
            </td>
            <td class="px-4 py-3 font-medium text-ink-900"><%= currency(product.price) %></td>
            <td class="px-4 py-3 <%= 'text-red-500 font-semibold' if product.stock <= 5 %>"><%= product.stock %></td>
            <td class="px-4 py-3"><span class="badge-<%= product.is_active? ? 'teal' : 'ink' %>"><%= product.is_active? ? "Active" : "Inactive" %></span></td>
            <td class="px-4 py-3">
              <%= render "admin/row_actions",
                    label: product.name,
                    view_path: admin_product_path(product),
                    edit_path: edit_admin_product_path(product),
                    delete_path: admin_product_path(product) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="card p-10 text-center text-sm text-ink-400">No products in this category yet.</div>
<% end %>
