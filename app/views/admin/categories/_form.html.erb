<%= form_with model: [:admin, category], class: "card p-6 space-y-4 max-w-xl" do |f| %>
  <% if category.errors.any? %>
    <div class="rounded-xl bg-red-50 border border-red-100 text-red-700 px-4 py-3 text-sm">
      <%= category.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <label class="label">Name</label>
    <%= f.text_field :name, class: "input" %>
  </div>

  <div>
    <label class="label">Slug (auto-generated if left blank)</label>
    <%= f.text_field :slug, class: "input" %>
  </div>

  <div>
    <label class="label">Parent Category (optional — leave blank for a top-level category)</label>
    <%= f.select :parent_id, options_from_collection_for_select(@parent_categories, :id, :name, category.parent_id), { include_blank: true }, class: "input" %>
  </div>

  <div>
    <label class="label">Description</label>
    <%= f.text_area :description, rows: 3, class: "input" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <label class="label">Position</label>
      <%= f.number_field :position, class: "input" %>
    </div>
    <div class="flex items-end pb-2.5">
      <label class="flex items-center gap-2 text-sm text-ink-600">
        <%= f.check_box :is_active, class: "rounded border-ink-300" %> Active
      </label>
    </div>
  </div>

  <%= f.submit "Save Category", class: "btn-primary" %>
<% end %>
