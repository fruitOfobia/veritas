<% content_for :title, "Users — Admin" %>

<h1 class="text-2xl mb-6">Users</h1>

<div class="card overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="bg-ink-50 text-ink-500 text-left">
      <tr>
        <th class="px-4 py-3 font-medium">Name</th>
        <th class="px-4 py-3 font-medium">Email</th>
        <th class="px-4 py-3 font-medium">Role</th>
        <th class="px-4 py-3 font-medium">Joined</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-ink-100">
      <% @users.each do |user| %>
        <tr>
          <td class="px-4 py-3"><%= link_to user.name, admin_user_path(user), class: "font-medium text-brand-600" %></td>
          <td class="px-4 py-3 text-ink-600"><%= user.email %></td>
          <td class="px-4 py-3"><span class="badge-<%= user.admin? ? 'brand' : 'ink' %>"><%= user.role.titleize %></span></td>
          <td class="px-4 py-3 text-ink-400"><%= user.created_at.strftime("%d %b %Y") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= render "shared/pagination", pagy: @pagy %>
