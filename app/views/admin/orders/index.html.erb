<% content_for :title, "Orders — Admin" %>

<h1 class="text-2xl mb-6">Orders</h1>

<div class="card overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="bg-ink-50 text-ink-500 text-left">
      <tr>
        <th class="px-4 py-3 font-medium">Order</th>
        <th class="px-4 py-3 font-medium">Customer</th>
        <th class="px-4 py-3 font-medium">Total</th>
        <th class="px-4 py-3 font-medium">Payment</th>
        <th class="px-4 py-3 font-medium">Status</th>
        <th class="px-4 py-3 font-medium">Placed</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-ink-100">
      <% @orders.each do |order| %>
        <tr>
          <td class="px-4 py-3"><%= link_to order.order_number, admin_order_path(order), class: "font-medium text-brand-600" %></td>
          <td class="px-4 py-3 text-ink-700"><%= order.user.name %></td>
          <td class="px-4 py-3 font-medium text-ink-900"><%= currency(order.total) %></td>
          <td class="px-4 py-3 text-ink-500 uppercase text-xs"><%= order.payment_method %></td>
          <td class="px-4 py-3"><span class="badge-<%= order.delivered? ? 'teal' : order.cancelled? ? 'ink' : 'brand' %>"><%= order.status.titleize %></span></td>
          <td class="px-4 py-3 text-ink-400"><%= order.created_at.strftime("%d %b %Y") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= render "shared/pagination", pagy: @pagy %>
