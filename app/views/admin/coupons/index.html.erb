<% content_for :title, "Coupons — Admin" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl">Coupons</h1>
  <%= link_to "+ New Coupon", new_admin_coupon_path, class: "btn-primary" %>
</div>

<div class="card overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="bg-ink-50 text-ink-500 text-left">
      <tr>
        <th class="px-4 py-3 font-medium">Code</th>
        <th class="px-4 py-3 font-medium">Discount</th>
        <th class="px-4 py-3 font-medium">Usage</th>
        <th class="px-4 py-3 font-medium">Valid Until</th>
        <th class="px-4 py-3 font-medium">Status</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-ink-100">
      <% @coupons.each do |coupon| %>
        <tr>
          <td class="px-4 py-3 font-mono font-medium text-ink-900"><%= coupon.code %></td>
          <td class="px-4 py-3 text-ink-600"><%= coupon.percentage? ? "#{coupon.discount_value.to_i}%" : currency(coupon.discount_value) %></td>
          <td class="px-4 py-3 text-ink-500"><%= coupon.used_count %><%= "/#{coupon.usage_limit}" if coupon.usage_limit.present? %></td>
          <td class="px-4 py-3 text-ink-400"><%= coupon.valid_until&.strftime("%d %b %Y") || "No expiry" %></td>
          <td class="px-4 py-3"><span class="badge-<%= coupon.is_active? ? 'teal' : 'ink' %>"><%= coupon.is_active? ? "Active" : "Inactive" %></span></td>
          <td class="px-4 py-3">
            <%= render "admin/row_actions",
                  label: coupon.code,
                  edit_path: edit_admin_coupon_path(coupon),
                  delete_path: admin_coupon_path(coupon) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
