<%= form_with model: [:admin, coupon], class: "card p-6 space-y-4 max-w-xl" do |f| %>
  <% if coupon.errors.any? %>
    <div class="rounded-xl bg-red-50 border border-red-100 text-red-700 px-4 py-3 text-sm">
      <%= coupon.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="grid sm:grid-cols-2 gap-4">
    <div>
      <label class="label">Code</label>
      <%= f.text_field :code, class: "input" %>
    </div>
    <div>
      <label class="label">Discount Type</label>
      <%= f.select :discount_type, Coupon.discount_types.keys.map { |k| [k.titleize, k] }, {}, class: "input" %>
    </div>
  </div>

  <div class="grid sm:grid-cols-2 gap-4">
    <div>
      <label class="label">Discount Value</label>
      <%= f.number_field :discount_value, step: "0.01", class: "input" %>
    </div>
    <div>
      <label class="label">Max Discount (₹, optional)</label>
      <%= f.number_field :max_discount_amount, step: "0.01", class: "input" %>
    </div>
  </div>

  <div class="grid sm:grid-cols-2 gap-4">
    <div>
      <label class="label">Min Order Amount (₹)</label>
      <%= f.number_field :min_order_amount, step: "0.01", class: "input" %>
    </div>
    <div>
      <label class="label">Usage Limit (optional)</label>
      <%= f.number_field :usage_limit, class: "input" %>
    </div>
  </div>

  <div class="grid sm:grid-cols-2 gap-4">
    <div>
      <label class="label">Valid From</label>
      <%= f.datetime_field :valid_from, class: "input" %>
    </div>
    <div>
      <label class="label">Valid Until</label>
      <%= f.datetime_field :valid_until, class: "input" %>
    </div>
  </div>

  <label class="flex items-center gap-2 text-sm text-ink-600">
    <%= f.check_box :is_active, class: "rounded border-ink-300" %> Active
  </label>

  <%= f.submit "Save Coupon", class: "btn-primary" %>
<% end %>
