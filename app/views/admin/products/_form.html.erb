<%= form_with model: [:admin, product], class: "card p-6 space-y-4 max-w-2xl" do |f| %>
  <% if product.errors.any? %>
    <div class="rounded-xl bg-red-50 border border-red-100 text-red-700 px-4 py-3 text-sm">
      <%= product.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="grid sm:grid-cols-2 gap-4">
    <div>
      <label class="label">Name</label>
      <%= f.text_field :name, class: "input" %>
    </div>
    <div>
      <label class="label">SKU</label>
      <%= f.text_field :sku, class: "input" %>
    </div>
  </div>

  <div class="grid sm:grid-cols-2 gap-4">
    <div>
      <label class="label">Category</label>
      <%= f.select :category_id, options_from_collection_for_select(@categories, :id, :name, product.category_id), {}, class: "input" %>
    </div>
    <div>
      <label class="label">Slug (auto-generated if left blank)</label>
      <%= f.text_field :slug, class: "input" %>
    </div>
  </div>

  <div>
    <label class="label">Description</label>
    <%= f.text_area :description, rows: 4, class: "input" %>
  </div>

  <div class="grid sm:grid-cols-2 gap-4">
    <div>
      <label class="label">Price (₹)</label>
      <%= f.number_field :price, step: "0.01", class: "input" %>
    </div>
    <div>
      <label class="label">MRP (₹, optional — shows a discount badge)</label>
      <%= f.number_field :mrp, step: "0.01", class: "input" %>
    </div>
  </div>

  <div class="grid sm:grid-cols-2 gap-4">
    <div>
      <label class="label">Stock</label>
      <%= f.number_field :stock, class: "input" %>
    </div>
    <div>
      <label class="label">Unit</label>
      <%= f.text_field :unit, class: "input", placeholder: "piece, sq.ft, box, kg…" %>
    </div>
  </div>

  <div>
    <label class="label">Images</label>
    <%= f.file_field :images, multiple: true, class: "input" %>
    <% if product.images.attached? %>
      <div class="flex gap-2 mt-2">
        <% product.images.each do |image| %>
          <%= image_tag image, class: "h-14 w-14 rounded-lg object-cover" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="flex gap-6">
    <label class="flex items-center gap-2 text-sm text-ink-600">
      <%= f.check_box :is_active, class: "rounded border-ink-300" %> Active
    </label>
    <label class="flex items-center gap-2 text-sm text-ink-600">
      <%= f.check_box :is_featured, class: "rounded border-ink-300" %> Featured
    </label>
  </div>

  <%= f.submit "Save Product", class: "btn-primary" %>
<% end %>
