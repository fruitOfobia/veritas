<% content_for :title, "#{@product.name} — Admin" %>

<nav class="text-sm text-ink-400 mb-4">
  <%= link_to "Products", admin_products_path, class: "hover:text-brand-600" %> /
  <span class="text-ink-700"><%= @product.name %></span>
</nav>

<div class="flex items-start justify-between gap-4 mb-6">
  <div>
    <h1 class="text-2xl"><%= @product.name %></h1>
    <p class="text-sm text-ink-400 mt-1">
      <span class="font-mono"><%= @product.sku %></span> •
      <%= link_to @product.category.name, admin_category_path(@product.category), class: "text-brand-600" %>
    </p>
  </div>
  <div class="flex items-center gap-2 shrink-0">
    <%= link_to "View on storefront", product_path(@product), class: "btn-outline !py-1.5", target: "_blank", rel: "noopener" %>
    <%= link_to "Edit", edit_admin_product_path(@product), class: "btn-primary !py-1.5" %>
  </div>
</div>

<div class="grid sm:grid-cols-4 gap-4 mb-8">
  <div class="card p-5">
    <p class="text-xs font-medium text-ink-400 uppercase tracking-wide">Price</p>
    <p class="text-2xl font-display font-bold text-ink-900 mt-1"><%= currency(@product.price) %></p>
    <p class="text-xs text-ink-400">per <%= @product.unit %></p>
  </div>
  <div class="card p-5">
    <p class="text-xs font-medium text-ink-400 uppercase tracking-wide">MRP</p>
    <p class="text-2xl font-display font-bold text-ink-900 mt-1"><%= @product.mrp.present? ? currency(@product.mrp) : "—" %></p>
    <% if @product.on_sale? %>
      <p class="text-xs text-brand-600 font-semibold"><%= @product.discount_percent %>% off</p>
    <% end %>
  </div>
  <div class="card p-5">
    <p class="text-xs font-medium text-ink-400 uppercase tracking-wide">Stock</p>
    <p class="text-2xl font-display font-bold mt-1 <%= @product.stock <= 5 ? 'text-red-500' : 'text-ink-900' %>"><%= @product.stock %></p>
  </div>
  <div class="card p-5">
    <p class="text-xs font-medium text-ink-400 uppercase tracking-wide">Rating</p>
    <p class="text-2xl font-display font-bold text-ink-900 mt-1"><%= @product.average_rating %></p>
    <p class="text-xs text-ink-400"><%= @reviews.size %> review<%= "s" unless @reviews.size == 1 %></p>
  </div>
</div>

<div class="grid lg:grid-cols-3 gap-6 mb-8">
  <div class="card p-5">
    <h3 class="text-sm font-semibold text-ink-900 mb-3">Images</h3>
    <% if @product.images.attached? %>
      <div class="grid grid-cols-3 gap-2">
        <% @product.images.each do |image| %>
          <%= image_tag image, class: "aspect-square w-full rounded-lg object-cover" %>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-ink-400">No images uploaded.</p>
    <% end %>
  </div>

  <div class="card p-5 lg:col-span-2">
    <h3 class="text-sm font-semibold text-ink-900 mb-3">Details</h3>
    <dl class="grid sm:grid-cols-2 gap-x-6 gap-y-3 text-sm">
      <div class="flex justify-between border-b border-ink-100 pb-2">
        <dt class="text-ink-400">Status</dt>
        <dd><span class="badge-<%= @product.is_active? ? 'teal' : 'ink' %>"><%= @product.is_active? ? "Active" : "Inactive" %></span></dd>
      </div>
      <div class="flex justify-between border-b border-ink-100 pb-2">
        <dt class="text-ink-400">Featured</dt>
        <dd class="text-ink-800 font-medium"><%= @product.is_featured? ? "Yes" : "No" %></dd>
      </div>
      <div class="flex justify-between border-b border-ink-100 pb-2">
        <dt class="text-ink-400">Slug</dt>
        <dd class="text-ink-800 font-mono text-xs"><%= @product.slug %></dd>
      </div>
      <div class="flex justify-between border-b border-ink-100 pb-2">
        <dt class="text-ink-400">Added</dt>
        <dd class="text-ink-800"><%= @product.created_at.strftime("%d %b %Y") %></dd>
      </div>
      <% @product.specifications.each do |key, value| %>
        <div class="flex justify-between border-b border-ink-100 pb-2">
          <dt class="text-ink-400"><%= key.to_s.titleize %></dt>
          <dd class="text-ink-800 text-right ml-4 truncate" title="<%= value %>"><%= value %></dd>
        </div>
      <% end %>
    </dl>

    <% if @product.description.present? %>
      <h3 class="text-sm font-semibold text-ink-900 mt-5 mb-1">Description</h3>
      <p class="text-sm text-ink-600"><%= @product.description %></p>
    <% end %>
  </div>
</div>

<div class="grid lg:grid-cols-2 gap-6">
  <div>
    <h2 class="text-lg font-semibold text-ink-900 mb-3">Recent orders</h2>
    <div class="card divide-y divide-ink-100">
      <% @order_items.each do |item| %>
        <%= link_to admin_order_path(item.order), class: "flex items-center justify-between p-4 hover:bg-ink-50" do %>
          <div>
            <span class="text-sm font-medium text-ink-800"><%= item.order.order_number %></span>
            <p class="text-xs text-ink-400">Qty <%= item.quantity %> • <%= item.order.created_at.strftime("%d %b %Y") %></p>
          </div>
          <span class="text-sm font-semibold text-ink-900"><%= currency(item.total_price) %></span>
        <% end %>
      <% end %>
      <% if @order_items.empty? %>
        <p class="p-4 text-sm text-ink-400">Not ordered yet.</p>
      <% end %>
    </div>
  </div>

  <div>
    <h2 class="text-lg font-semibold text-ink-900 mb-3">Reviews</h2>
    <div class="card divide-y divide-ink-100">
      <% @reviews.each do |review| %>
        <div class="p-4">
          <div class="flex items-center justify-between">
            <span class="text-sm font-medium text-ink-800"><%= review.user.name %></span>
            <span class="text-brand-500 text-sm"><%= star_rating(review.rating) %></span>
          </div>
          <% if review.comment.present? %>
            <p class="text-sm text-ink-600 mt-1"><%= review.comment %></p>
          <% end %>
        </div>
      <% end %>
      <% if @reviews.empty? %>
        <p class="p-4 text-sm text-ink-400">No reviews yet.</p>
      <% end %>
    </div>
  </div>
</div>
