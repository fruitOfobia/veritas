<% content_for :title, "Your Addresses — BuildBazaar" %>

<div class="container-page py-10 max-w-3xl">
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-3xl">Your Addresses</h1>
    <%= link_to "Add Address", new_address_path, class: "btn-primary" %>
  </div>

  <% if @addresses.any? %>
    <div class="space-y-4">
      <% @addresses.each do |address| %>
        <div class="card p-5 flex items-start justify-between">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <p class="font-semibold text-ink-900"><%= address.label %></p>
              <% if address.is_default? %>
                <span class="badge-brand">Default</span>
              <% end %>
            </div>
            <p class="text-sm text-ink-600"><%= address.to_s %></p>
          </div>
          <div class="flex items-center gap-3 shrink-0">
            <%= link_to "Edit", edit_address_path(address), class: "text-sm font-medium text-ink-600 hover:text-brand-600" %>
            <%= button_to "Delete", address_path(address), method: :delete, class: "text-sm font-medium text-red-500 hover:text-red-600 bg-transparent p-0", form: { data: { turbo_confirm: "Delete this address?" } } %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <%= render "shared/empty_state", title: "No addresses yet", message: "Add an address to speed up checkout.", cta_text: "Add Address", cta_path: new_address_path %>
  <% end %>
</div>
