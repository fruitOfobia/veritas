<% content_for :title, "Request a Quote — Veritas" %>

<div class="container-page py-10 max-w-3xl">
  <h1 class="text-3xl mb-2">Request a Bulk Quote</h1>
  <p class="text-ink-500 mb-8">Tell us what you need and our team will get back to you with contractor pricing within 24 hours.</p>

  <%= form_with model: @quote, url: quotes_path, data: { controller: "nested-form" } do |f| %>
    <% if @quote.errors.any? %>
      <div class="rounded-xl bg-red-50 border border-red-100 text-red-700 px-4 py-3 text-sm mb-6">
        <%= @quote.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div class="card p-6 mb-6">
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="label">Company Name (optional)</label>
          <%= f.text_field :company_name, class: "input" %>
        </div>
        <div>
          <label class="label">GSTIN (optional)</label>
          <%= text_field_tag nil, current_user.gstin, disabled: true, class: "input !bg-ink-50" %>
        </div>
      </div>
    </div>

    <div class="card p-6 mb-6">
      <div class="flex items-center justify-between mb-2">
        <h3 class="font-semibold text-ink-900">Line Items</h3>
        <button type="button" data-action="nested-form#add" class="text-sm font-semibold text-brand-600 hover:text-brand-700">+ Add product</button>
      </div>

      <%= f.fields_for :quote_items do |qi| %>
        <%= render "quote_item_fields", f: qi %>
      <% end %>

      <template data-nested-form-target="template">
        <%= f.fields_for :quote_items, QuoteItem.new, child_index: "NEW_RECORD" do |qi| %>
          <%= render "quote_item_fields", f: qi %>
        <% end %>
      </template>
    </div>

    <div class="card p-6 mb-6">
      <label class="label">Additional Notes</label>
      <%= f.text_area :notes, rows: 3, class: "input", placeholder: "Delivery timeline, site address, special requirements…" %>
    </div>

    <%= f.submit "Submit Quote Request", class: "btn-primary px-8" %>
  <% end %>
</div>
