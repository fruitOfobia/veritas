<% content_for :title, "Edit Profile — Veritas" %>

<div class="container-page py-10 max-w-lg">
  <h1 class="text-3xl mb-8">Edit Profile</h1>

  <%= form_with model: current_user, url: profile_path, class: "card p-6 space-y-4" do |f| %>
    <% if current_user.errors.any? %>
      <div class="rounded-xl bg-red-50 border border-red-100 text-red-700 px-4 py-3 text-sm">
        <%= current_user.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label class="label">First Name</label>
        <%= f.text_field :first_name, class: "input" %>
      </div>
      <div>
        <label class="label">Last Name</label>
        <%= f.text_field :last_name, class: "input" %>
      </div>
    </div>

    <div>
      <label class="label">Company Name (optional)</label>
      <%= f.text_field :company_name, class: "input" %>
    </div>

    <div>
      <label class="label">GSTIN (optional)</label>
      <%= f.text_field :gstin, class: "input" %>
    </div>

    <%= f.submit "Save Changes", class: "btn-primary" %>
  <% end %>

  <p class="text-sm text-ink-400 mt-4">
    Want to change your password or email? <%= link_to "Manage account", edit_user_registration_path, class: "text-brand-600 font-semibold" %>
  </p>
</div>
